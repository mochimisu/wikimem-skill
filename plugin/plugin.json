{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "wikimem",
  "version": "0.2.0",
  "description": "Shared Markdown memory with scoped retrieval, safe maintenance, and source-backed ingestion across assistants.",
  "keywords": ["memory", "wiki", "research"],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Wikimem",
        "shortDescription": "Your detailed memory across assistants",
        "category": "Productivity",
        "capabilities": ["Read", "Write"],
        "brandColor": "#2c6651"
      }
    }
  }
}
